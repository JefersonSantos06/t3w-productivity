<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.jefersonsantos06.t3wproductivity</id>
    <name>T3w-Productivity</name>
    <vendor>jefersonsantos06</vendor>

    <!-- Só a plataforma é obrigatória, para o plugin rodar também no DataGrip (sem Java). -->
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="t3w-java.xml">com.intellij.modules.java</depends>
    <depends optional="true" config-file="t3w-database.xml">com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                id="t3w.productivity.flyway.settings"
                displayName="T3W Productivity"
                parentId="tools"
                instance="com.github.jefersonsantos06.t3wproductivity.settings.MainSettingsConfigurable"/>
        <!-- Web components do Vaadin no HTML e no CSS; arquivo gerado por scripts/generate-vaadin-web-types.mjs -->
        <polySymbols.webTypes source="web-types/vaadin.web-types.json" enableByDefault="true"/>
        <notificationGroup id="T3W Migrations" displayType="BALLOON"/>
        <editorNotificationProvider implementation="com.github.jefersonsantos06.t3wproductivity.migration.MigrationGuardNotificationProvider"/>
        <postStartupActivity implementation="com.github.jefersonsantos06.t3wproductivity.migration.MigrationGuardStartupActivity"/>
        <notificationGroup id="T3W Novidades" displayType="STICKY_BALLOON"/>
        <postStartupActivity implementation="com.github.jefersonsantos06.t3wproductivity.whatsnew.WhatsNewStartupActivity"/>
    </extensions>

    <projectListeners>
        <!-- Grava o resultado do Flyway para as IDEs com o plugin Database (esta ou outra, ex.: DataGrip). -->
        <listener class="com.github.jefersonsantos06.t3wproductivity.database.FlywayIntrospectionExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <actions>
        <group id="t3w.productivity.group" text="T3W Productivity" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingNewGroup"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <action id="t3w.productivity.createFlywayMigration"
                    class="com.github.jefersonsantos06.t3wproductivity.actions.FlywayMigrationCreateAction"
                    text="Criar Migration"/>
            <action id="t3w.productivity.adjustFlywayMigrationName"
                    class="com.github.jefersonsantos06.t3wproductivity.actions.FlywayMigrationAdjustNameAction"
                    text="Ajustar Nome Da Migration"/>
        </group>

        <group id="t3w.productivity.toolsMenuGroup" text="T3W Productivity" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <reference ref="t3w.productivity.createFlywayMigration"/>
            <action id="t3w.productivity.whatsNew"
                    class="com.github.jefersonsantos06.t3wproductivity.whatsnew.WhatsNewAction"
                    text="O Que Há De Novo"/>
        </group>
    </actions>
</idea-plugin>
